  <Operation Class="PatchOperationConditional">
    <xpath>Defs/ThingDef[defName="JP_JapaneseWolf"]/comps/li[@Class="CompProperties_Shearable"]/woolAmount</xpath>
    <match Class="PatchOperationReplace">
      <xpath>Defs/ThingDef[defName="JP_JapaneseWolf"]/comps/li[@Class="CompProperties_Shearable"]/woolAmount</xpath>
      <value><woolAmount>44</woolAmount></value>
