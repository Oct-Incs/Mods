<Defs>

  <!-- ============================================================
       ニホンオオカミ (Japanese Wolf) - 森に群れる俊敏な捕食獣。
       特殊能力: 移動が速い、大型 / 妊娠条件: 通常の交配
       ============================================================ -->
  <ThingDef ParentName="AnimalThingBase">
    <defName>JP_JapaneseWolf</defName>
    <label>Japanese wolf</label>
    <description>森林地帯に小さな群れで生息する、俊敏で狡猾な大型の狼。単独の獲物には容赦なく襲いかかる。傷を負わせると仲間ごと激昂することがある。\n\nA lean, cunning, sizeable wolf that roams temperate and boreal forests in small packs. Ruthless against lone prey, and prone to provoking the whole pack if wounded.</description>
    <statBases>
      <MoveSpeed>5.4</MoveSpeed>
      <ComfyTemperatureMin>-30</ComfyTemperatureMin>
      <ComfyTemperatureMax>28</ComfyTemperatureMax>
      <ArmorRating_Sharp>0.05</ArmorRating_Sharp>
      <Wildness>0.93</Wildness>
    </statBases>
    <race>
      <body>QuadrupedAnimalWithPawsAndTail</body>
      <baseBodySize>1.3</baseBodySize>
      <baseHealthScale>1.2</baseHealthScale>
      <baseHungerRate>0.6</baseHungerRate>
      <foodType>OmnivoreRoughAnimal</foodType>
      <predator>false</predator>
      <leatherDef>JP_Leather_AncientBeast</leatherDef>
      <specificMeatDef>JP_Meat_JapaneseWolf</specificMeatDef>
      <manhunterOnDamageChance>0.35</manhunterOnDamageChance>
      <manhunterOnTameFailChance>0.12</manhunterOnTameFailChance>
      <trainability>Intermediate</trainability>
      <herdAnimal>true</herdAnimal>
      <canBePredatorPrey>true</canBePredatorPrey>
      <hasGenders>true</hasGenders>
      <gestationPeriodDays>8</gestationPeriodDays>
      <lifeExpectancy>11</lifeExpectancy>
      <lifeStageAges>
        <li><def>AnimalBaby</def><minAge>0</minAge></li>
        <li><def>AnimalJuvenile</def><minAge>0.3</minAge></li>
        <li>
          <def>AnimalAdult</def>
          <minAge>0.8</minAge>
          <soundWounded>Pawn_Warg_Wounded</soundWounded>
          <soundDeath>Pawn_Warg_Death</soundDeath>
          <soundCall>Pawn_Warg_Call</soundCall>
          <soundAngry>Pawn_Warg_Angry</soundAngry>
        </li>
      </lifeStageAges>
      <soundMeleeHitPawn>Pawn_Melee_SmallScratch_HitPawn</soundMeleeHitPawn>
      <soundMeleeHitBuilding>Pawn_Melee_SmallScratch_HitBuilding</soundMeleeHitBuilding>
      <soundMeleeMiss>Pawn_Melee_SmallScratch_Miss</soundMeleeMiss>
    </race>
    <comps>
      <li Class="CompProperties_Shearable">
        <woolDef>JP_Wool_AncientBeast</woolDef>
        <shearIntervalDays>10</shearIntervalDays>
        <woolAmount>20</woolAmount>
      </li>
    </comps>
    <tools>
      <li>
        <label>tooth</label>
        <capacities><li>Bite</li></capacities>
        <power>9</power>
        <cooldownTime>2.0</cooldownTime>
        <linkedBodyPartsGroup>Teeth</linkedBodyPartsGroup>
      </li>
      <li>
        <label>front claw</label>
        <capacities><li>Scratch</li></capacities>
        <power>6</power>
        <cooldownTime>1.7</cooldownTime>
        <linkedBodyPartsGroup>FrontLeftPaw</linkedBodyPartsGroup>
      </li>
      <li>
        <label>front claw</label>
        <capacities><li>Scratch</li></capacities>
        <power>6</power>
        <cooldownTime>1.7</cooldownTime>
        <linkedBodyPartsGroup>FrontRightPaw</linkedBodyPartsGroup>
        <chanceFactor>0.7</chanceFactor>
      </li>
    </tools>
    <graphicData>
      <texPath>Things/Pawn/Animal/JP_JapaneseWolf/JP_JapaneseWolf</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <drawSize>1.6</drawSize>
      <shadowData><volume>(0.45, 0.4, 0.3)</volume></shadowData>
    </graphicData>
  </ThingDef>

