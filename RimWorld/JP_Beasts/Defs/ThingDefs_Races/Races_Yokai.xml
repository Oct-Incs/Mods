  <!-- ============================================================
       座敷童 (Zashikiwarashi) - 家に富をもたらすと伝わる子供の姿の精霊。
       特殊能力: テイムすると稀に銀を生産する。非好戦的でほぼ無害。
       ============================================================ -->
  <ThingDef ParentName="AnimalThingBase">
    <defName>JP_Zashikiwarashi</defName>
    <label>zashikiwarashi</label>
    <description>古い家に住み着き、富をもたらすと伝わる子供の姿の精霊。ほとんど戦う力を持たないが、いたずら好きで人前にふらりと現れる。テイムして懐かせると、ごく稀に銀を生み出すという。\n\nA child-shaped spirit said to bring fortune to the old house it dwells in. It has almost no fighting ability and is mischievous, sometimes wandering into view. If tamed, it is said to occasionally produce silver.</description>
    <statBases>
      <MoveSpeed>5.0</MoveSpeed>
      <ComfyTemperatureMin>-20</ComfyTemperatureMin>
      <ComfyTemperatureMax>35</ComfyTemperatureMax>
      <Wildness>0.985</Wildness>
    </statBases>
    <race>
      <body>Human</body>
      <intelligence>Animal</intelligence>
      <baseBodySize>0.5</baseBodySize>
      <baseHealthScale>0.6</baseHealthScale>
      <baseHungerRate>0.35</baseHungerRate>
      <foodType>OmnivoreRoughAnimal</foodType>
      <predator>false</predator>
      <leatherDef>JP_Leather_RareSpecies</leatherDef>
      <meatDef>Meat_Human</meatDef>
      <manhunterOnDamageChance>0.00</manhunterOnDamageChance>
      <manhunterOnTameFailChance>0.00</manhunterOnTameFailChance>
      <trainability>Intermediate</trainability>
      <herdAnimal>false</herdAnimal>
      <canBePredatorPrey>true</canBePredatorPrey>
      <hasGenders>true</hasGenders>
      <gestationPeriodDays>6</gestationPeriodDays>
      <lifeExpectancy>25</lifeExpectancy>
      <lifeStageAges>
        <li><def>AnimalBaby</def><minAge>0</minAge></li>
        <li><def>AnimalJuvenile</def><minAge>0.25</minAge></li>
        <li><def>AnimalAdult</def><minAge>0.7</minAge></li>
      </lifeStageAges>
      <soundMeleeHitPawn>Pawn_Melee_SmallScratch_HitPawn</soundMeleeHitPawn>
      <soundMeleeHitBuilding>Pawn_Melee_SmallScratch_HitBuilding</soundMeleeHitBuilding>
      <soundMeleeMiss>Pawn_Melee_SmallScratch_Miss</soundMeleeMiss>
    </race>
    <comps>
      <li Class="CompProperties_Shearable">
        <woolDef>JP_Wool_RareSpecies</woolDef>
        <shearIntervalDays>12</shearIntervalDays>
        <woolAmount>15</woolAmount>
      </li>
      <!-- "稀に銀を生産する" - Milkable comp repurposed to yield Silver on a
           long interval. Independent of the mating/pregnancy system, so it
           does not affect normal reproduction. Requires the animal to be
           tamed, matching the requested behavior. -->
      <li Class="CompProperties_Milkable">
        <milkDef>Silver</milkDef>
        <milkIntervalDays>20</milkIntervalDays>
        <milkAmount>8</milkAmount>
      </li>
    </comps>
    <tools>
      <li>
        <label>left slap</label>
        <capacities><li>Blunt</li></capacities>
        <power>3</power>
        <cooldownTime>2.0</cooldownTime>
        <linkedBodyPartsGroup>LeftHand</linkedBodyPartsGroup>
      </li>
      <li>
        <label>right slap</label>
        <capacities><li>Blunt</li></capacities>
        <power>3</power>
        <cooldownTime>2.0</cooldownTime>
        <linkedBodyPartsGroup>RightHand</linkedBodyPartsGroup>
      </li>
    </tools>
    <graphicData>
      <texPath>Things/Pawn/Animal/JP_Zashikiwarashi/JP_Zashikiwarashi</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <drawSize>0.9</drawSize>
      <shadowData><volume>(0.3, 0.35, 0.2)</volume></shadowData>
    </graphicData>
  </ThingDef>

