<Defs>

  <!-- ============================================================
       猫又 (Nekomata) - 森に潜む俊敏な化け猫。特殊能力: 移動が速い
       ============================================================ -->
  <ThingDef ParentName="AnimalThingBase">
    <defName>JP_Nekomata</defName>
    <label>nekomata</label>
    <description>年経て妖力を得た猫が変じた化け物。二又に分かれた尾を持ち、木々の間を音もなく駆け抜けて獲物に飛びかかる。人里近くの森でごく稀に目撃される。\n\nA cat that has lived long enough to gain supernatural power and transform into a monster, marked by its forked tail. It darts silently through the trees before pouncing on prey, rarely glimpsed in forests near settlements.</description>
    <statBases>
      <MoveSpeed>5.8</MoveSpeed>
      <ComfyTemperatureMin>-20</ComfyTemperatureMin>
      <ComfyTemperatureMax>35</ComfyTemperatureMax>
      <ArmorRating_Sharp>0.08</ArmorRating_Sharp>
      <Wildness>0.985</Wildness>
    </statBases>
    <race>
      <body>Human</body>
      <intelligence>Animal</intelligence>
      <baseBodySize>0.9</baseBodySize>
      <baseHealthScale>1.0</baseHealthScale>
      <baseHungerRate>0.6</baseHungerRate>
      <foodType>OmnivoreRoughAnimal</foodType>
      <predator>false</predator>
      <leatherDef>JP_Leather_RareSpecies</leatherDef>
      <meatDef>Meat_Human</meatDef>
      <manhunterOnDamageChance>0.00</manhunterOnDamageChance>
      <manhunterOnTameFailChance>0.00</manhunterOnTameFailChance>
      <trainability>Intermediate</trainability>
      <herdAnimal>false</herdAnimal>
      <canBePredatorPrey>true</canBePredatorPrey>
      <hasGenders>true</hasGenders>
      <gestationPeriodDays>7</gestationPeriodDays>
      <lifeExpectancy>25</lifeExpectancy>
      <lifeStageAges>
        <li><def>AnimalBaby</def><minAge>0</minAge></li>
        <li><def>AnimalJuvenile</def><minAge>0.25</minAge></li>
        <li><def>AnimalAdult</def><minAge>0.7</minAge></li>
      </lifeStageAges>
      <soundMeleeHitPawn>Pawn_Melee_SmallScratch_HitPawn</soundMeleeHitPawn>
      <soundMeleeHitBuilding>Pawn_Melee_SmallScratch_HitBuilding</soundMeleeHitBuilding>
      <soundMeleeMiss>Pawn_Melee_SmallScratch_Miss</soundMeleeMiss>
    </race>
    <comps>
      <li Class="CompProperties_Shearable">
        <woolDef>JP_Wool_RareSpecies</woolDef>
        <shearIntervalDays>12</shearIntervalDays>
        <woolAmount>25</woolAmount>
      </li>
    </comps>
    <tools>
      <li>
        <label>left claw</label>
        <capacities><li>Scratch</li></capacities>
        <power>8</power>
        <cooldownTime>1.6</cooldownTime>
        <linkedBodyPartsGroup>LeftHand</linkedBodyPartsGroup>
      </li>
      <li>
        <label>right claw</label>
        <capacities><li>Scratch</li></capacities>
        <power>8</power>
        <cooldownTime>1.6</cooldownTime>
        <linkedBodyPartsGroup>RightHand</linkedBodyPartsGroup>
      </li>
    </tools>
    <graphicData>
      <texPath>Things/Pawn/Animal/JP_Nekomata/JP_Nekomata</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <drawSize>1.3</drawSize>
      <shadowData><volume>(0.35, 0.4, 0.25)</volume></shadowData>
    </graphicData>
  </ThingDef>

