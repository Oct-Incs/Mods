<Defs>

  <!-- ============================================================
       アースロプレウラ (Arthropleura) - 分厚い装甲を持つ古代の巨大多脚類。
       鈍重だが防御に優れる。妊娠条件: 卵生
       ============================================================ -->
  <ThingDef ParentName="AnimalThingBase">
    <defName>JP_Arthropleura</defName>
    <label>arthropleura</label>
    <description>体節ごとに硬い装甲を持つ、古代の巨大な多脚類。動きは鈍いが、その装甲は並の攻撃をほとんど通さない。普段は腐植質を食べる大人しい生物だが、追い詰めると体当たりで反撃する。\n\nA giant ancient many-legged arthropod armored segment by segment. Slow-moving, but its plating turns aside most attacks. Normally a placid detritivore, it retaliates by slamming into attackers when cornered.</description>
    <statBases>
      <MoveSpeed>3.5</MoveSpeed>
      <ComfyTemperatureMin>-10</ComfyTemperatureMin>
      <ComfyTemperatureMax>40</ComfyTemperatureMax>
      <ArmorRating_Sharp>0.40</ArmorRating_Sharp>
      <ArmorRating_Blunt>0.35</ArmorRating_Blunt>
      <Wildness>0.96</Wildness>
    </statBases>
    <race>
      <body>QuadrupedAnimalWithPawsAndTail</body>
      <baseBodySize>1.8</baseBodySize>
      <baseHealthScale>2.2</baseHealthScale>
      <baseHungerRate>0.9</baseHungerRate>
      <foodType>VegetarianRoughAnimal</foodType>
      <predator>false</predator>
      <leatherDef>JP_Chitin_Ancient</leatherDef>
      <useMeatFrom>Megaspider</useMeatFrom>
      <manhunterOnDamageChance>1.0</manhunterOnDamageChance>
      <manhunterOnTameFailChance>0.28</manhunterOnTameFailChance>
      <trainability>Intermediate</trainability>
      <herdAnimal>false</herdAnimal>
      <canBePredatorPrey>true</canBePredatorPrey>
      <hasGenders>true</hasGenders>
      <gestationPeriodDays>6</gestationPeriodDays>
      <lifeExpectancy>10</lifeExpectancy>
      <lifeStageAges>
        <li><def>AnimalBaby</def><minAge>0</minAge></li>
        <li><def>AnimalJuvenile</def><minAge>0.2</minAge></li>
        <li>
          <def>AnimalAdult</def>
          <minAge>0.6</minAge>
          <soundWounded>Pawn_BigInsect_Pain</soundWounded>
          <soundDeath>Pawn_BigInsect_Death</soundDeath>
          <soundCall>Pawn_BigInsect_Call</soundCall>
          <soundAngry>Pawn_BigInsect_Angry</soundAngry>
        </li>
      </lifeStageAges>
      <soundMeleeHitPawn>Pawn_Melee_BigBash_HitPawn</soundMeleeHitPawn>
      <soundMeleeHitBuilding>Pawn_Melee_BigBash_HitBuilding</soundMeleeHitBuilding>
      <soundMeleeMiss>Pawn_Melee_BigBash_Miss</soundMeleeMiss>
    </race>
    <comps>
      <li Class="CompProperties_EggLayer">
        <eggFertilizedDef>JP_Egg_ArthropleuraFert</eggFertilizedDef>
        <eggUnfertilizedDef>JP_Egg_ArthropleuraUnfert</eggUnfertilizedDef>
        <eggFertilizationCountMax>1</eggFertilizationCountMax>
        <eggLayIntervalDays>5</eggLayIntervalDays>
        <eggProgressUnfertilizedMax>0.5</eggProgressUnfertilizedMax>
        <eggCountRange>1</eggCountRange>
      </li>
    </comps>
    <tools>
      <li>
        <label>mandible</label>
        <capacities><li>Bite</li></capacities>
        <power>8</power>
        <cooldownTime>1.8</cooldownTime>
        <linkedBodyPartsGroup>Teeth</linkedBodyPartsGroup>
      </li>
      <li>
        <label>body slam</label>
        <capacities><li>Blunt</li></capacities>
        <power>12</power>
        <cooldownTime>2.2</cooldownTime>
        <linkedBodyPartsGroup>FrontLeftPaw</linkedBodyPartsGroup>
      </li>
      <li>
        <label>body slam</label>
        <capacities><li>Blunt</li></capacities>
        <power>12</power>
        <cooldownTime>2.2</cooldownTime>
        <linkedBodyPartsGroup>FrontRightPaw</linkedBodyPartsGroup>
        <chanceFactor>0.7</chanceFactor>
      </li>
    </tools>
    <graphicData>
      <texPath>Things/Pawn/Animal/JP_Arthropleura/JP_Arthropleura</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <drawSize>1.9</drawSize>
      <shadowData><volume>(0.6, 0.4, 0.3)</volume></shadowData>
    </graphicData>
  </ThingDef>

  <!-- ============================================================
       プルモノスコルピウス (Pulmonoscorpius) - 毒針を持つ古代の巨大サソリ。
       妊娠条件: 卵生
       ============================================================ -->
  <ThingDef ParentName="AnimalThingBase">
    <defName>JP_Pulmonoscorpius</defName>
    <label>pulmonoscorpius</label>
    <description>乾いた荒野に潜む、古代の巨大なサソリ。硬い外骨格に覆われ、尾の毒針は獲物を瞬く間に弱らせる。物陰でじっと獲物を待ち、一撃で仕留める待ち伏せ型の捕食者。\n\nA giant ancient scorpion lurking in arid wastes, its hard exoskeleton covering a body tipped with a venomous stinger that quickly weakens prey. An ambush predator that waits motionless before striking.</description>
    <statBases>
      <MoveSpeed>4.8</MoveSpeed>
      <ComfyTemperatureMin>-5</ComfyTemperatureMin>
      <ComfyTemperatureMax>48</ComfyTemperatureMax>
      <ArmorRating_Sharp>0.25</ArmorRating_Sharp>
      <Wildness>0.96</Wildness>
    </statBases>
    <race>
      <body>QuadrupedAnimalWithPawsAndTail</body>
      <baseBodySize>1.6</baseBodySize>
      <baseHealthScale>1.8</baseHealthScale>
      <baseHungerRate>0.75</baseHungerRate>
      <foodType>OmnivoreRoughAnimal</foodType>
      <predator>false</predator>
      <leatherDef>JP_Chitin_Ancient</leatherDef>
      <useMeatFrom>Megaspider</useMeatFrom>
      <manhunterOnDamageChance>1.0</manhunterOnDamageChance>
      <manhunterOnTameFailChance>0.28</manhunterOnTameFailChance>
      <trainability>Intermediate</trainability>
      <herdAnimal>false</herdAnimal>
      <canBePredatorPrey>true</canBePredatorPrey>
      <hasGenders>true</hasGenders>
      <gestationPeriodDays>5</gestationPeriodDays>
      <lifeExpectancy>9</lifeExpectancy>
      <lifeStageAges>
        <li><def>AnimalBaby</def><minAge>0</minAge></li>
        <li><def>AnimalJuvenile</def><minAge>0.2</minAge></li>
        <li>
          <def>AnimalAdult</def>
          <minAge>0.5</minAge>
          <soundWounded>Pawn_BigInsect_Pain</soundWounded>
          <soundDeath>Pawn_BigInsect_Death</soundDeath>
          <soundCall>Pawn_BigInsect_Call</soundCall>
          <soundAngry>Pawn_BigInsect_Angry</soundAngry>
        </li>
      </lifeStageAges>
      <soundMeleeHitPawn>Pawn_Melee_SmallScratch_HitPawn</soundMeleeHitPawn>
      <soundMeleeHitBuilding>Pawn_Melee_SmallScratch_HitBuilding</soundMeleeHitBuilding>
      <soundMeleeMiss>Pawn_Melee_SmallScratch_Miss</soundMeleeMiss>
    </race>
    <comps>
      <li Class="CompProperties_EggLayer">
        <eggFertilizedDef>JP_Egg_PulmonoscorpiusFert</eggFertilizedDef>
        <eggUnfertilizedDef>JP_Egg_PulmonoscorpiusUnfert</eggUnfertilizedDef>
        <eggFertilizationCountMax>1</eggFertilizationCountMax>
        <eggLayIntervalDays>4</eggLayIntervalDays>
        <eggProgressUnfertilizedMax>0.5</eggProgressUnfertilizedMax>
        <eggCountRange>1~2</eggCountRange>
      </li>
    </comps>
    <tools>
      <li>
        <label>pincer</label>
        <capacities><li>Blunt</li></capacities>
        <power>9</power>
        <cooldownTime>1.7</cooldownTime>
        <linkedBodyPartsGroup>FrontLeftPaw</linkedBodyPartsGroup>
      </li>
      <li>
        <label>pincer</label>
        <capacities><li>Blunt</li></capacities>
        <power>9</power>
        <cooldownTime>1.7</cooldownTime>
        <linkedBodyPartsGroup>FrontRightPaw</linkedBodyPartsGroup>
        <chanceFactor>0.7</chanceFactor>
      </li>
      <li>
        <label>venomous stinger</label>
        <capacities><li>Stab</li></capacities>
        <power>7</power>
        <cooldownTime>2.0</cooldownTime>
        <linkedBodyPartsGroup>Teeth</linkedBodyPartsGroup>
        <extraMeleeDamages>
          <li><def>ToxicBite</def><amount>6</amount></li>
        </extraMeleeDamages>
      </li>
    </tools>
    <graphicData>
      <texPath>Things/Pawn/Animal/JP_Pulmonoscorpius/JP_Pulmonoscorpius</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <drawSize>1.7</drawSize>
      <shadowData><volume>(0.55, 0.4, 0.3)</volume></shadowData>
    </graphicData>
  </ThingDef>

  <!-- ============================================================
       メガラクネ (Megarachne) - 森に潜む古代の巨大蜘蛛型待ち伏せ捕食者。
       妊娠条件: 卵生
       ============================================================ -->
