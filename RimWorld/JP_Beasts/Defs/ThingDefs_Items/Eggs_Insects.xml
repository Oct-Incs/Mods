<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- ================ Arthropleura ================ -->
  <ThingDef ParentName="EggFertBase">
    <defName>JP_Egg_ArthropleuraFert</defName>
    <label>arthropleura egg (fert.)</label>
    <description>アースロプレウラの受精卵。うまくいけばアースロプレウラの幼体が孵化する。\n\nA fertilized arthropleura egg. Given time, it should hatch into a young arthropleura.</description>
    <tradeability>None</tradeability>
    <statBases><MarketValue>7</MarketValue><Mass>0.3</Mass></statBases>
    <graphicData>
      <texPath>Things/Item/Resource/Egg/JP_Egg_Arthropleura</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <color>(110, 130, 90)</color>
    </graphicData>
    <comps>
      <li Class="CompProperties_Hatcher">
        <hatcherDaystoHatch>12</hatcherDaystoHatch>
        <hatcherPawn>JP_Arthropleura</hatcherPawn>
      </li>
    </comps>
  </ThingDef>
  <ThingDef ParentName="EggUnfertBase">
    <defName>JP_Egg_ArthropleuraUnfert</defName>
    <label>arthropleura egg (unfert.)</label>
    <description>アースロプレウラの未受精卵。孵化はしないが、食用・売却用として扱える。\n\nAn unfertilized arthropleura egg. It won't hatch, but can be eaten or sold.</description>
    <graphicData>
      <texPath>Things/Item/Resource/Egg/JP_Egg_Arthropleura</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <color>(110, 130, 90)</color>
    </graphicData>
    <tradeability>Sellable</tradeability>
    <statBases><MarketValue>7</MarketValue><Mass>0.3</Mass></statBases>
  </ThingDef>

